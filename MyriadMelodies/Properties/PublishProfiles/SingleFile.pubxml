<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/src/MyriadMelodies</PathMap>
    <AssemblyName>MyriadMelodies</AssemblyName>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
  <Target Name="SelectStandaloneRuntimePatch" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup>
      <KnownFrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WindowsForms;Microsoft.WindowsDesktop.App.WPF"
                               Condition="'%(KnownFrameworkReference.TargetFramework)' == 'net10.0'">
        <LatestRuntimeFrameworkVersion>10.0.14</LatestRuntimeFrameworkVersion>
      </KnownFrameworkReference>
    </ItemGroup>
  </Target>
</Project>
